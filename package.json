{
  "name": "nimbus-play",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:vite": "vite --host 0.0.0.0",
    "dev:relay": "tsx server/relay.ts",
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,RELAY\" -c \"cyan.bold,magenta.bold\" \"npm run dev:vite\" \"npm run dev:relay\"",
    "build": "tsc && vite build",
    "test": "tsx --test tests/**/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
